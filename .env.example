AGENT_LAB_ENVIRONMENT=development
AGENT_LAB_DATABASE_URL=sqlite:///./var/agent-lab.db
AGENT_LAB_LOG_LEVEL=INFO
AGENT_LAB_FRONTEND_ORIGIN=http://localhost:5173
AGENT_LAB_OPENAI_MODEL=gpt-5-mini
# AGENT_LAB_OPENAI_API_KEY=use-a-local-uncommitted-secret
# What a provider key saved from /settings is encrypted with. Commented out on purpose: there
# is no default, and with none set the lab refuses to store a key rather than pretending to
# protect one (ADR 0052). This must be KEY MATERIAL, not a phrase you can remember — mint one
# with `openssl rand -base64 32`. The lab derives its cipher key with HKDF, which is one hash
# per guess, so the promise that a copied database carries no usable credential holds only for
# a value nobody can guess. Uncommenting this without filling it in changes nothing: an empty
# or blank value is treated as unset, and saving a key is refused rather than encrypted under
# a key derived from nothing.
# AGENT_LAB_CREDENTIAL_KEY=
# AGENT_LAB_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# Replace this local-only value outside a disposable development environment.
AGENT_LAB_TELEMETRY_HASH_SALT=agent-lab-local-only
# Local Vite development proxies /api to localhost:8000. Set VITE_API_BASE_URL only in a
# frontend build environment that intentionally uses a different API origin. Vite's port and
# proxy target are shell variables rather than settings in this file; see docs/development.md.
